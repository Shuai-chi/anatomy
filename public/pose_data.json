{
  "_meta": {
    "_comment": "SKIP THIS KEY WHEN ITERATING EXERCISES. All other top-level keys are exercise_id.",
    "is_schematic_dataset": true,
    "provenance": "Angles derived from each exercise's joint_actions field by anatomical reasoning. NOT motion capture, NOT goniometer measurement, NOT from any published kinematics dataset. Intended to make the movement readable at a glance, not to be biomechanically exact.",
    "phase_convention": "start = beginning of the concentric (the stretched/loaded position, e.g. bar at chest); end = completion of the concentric (e.g. lockout). This matches the direction of each exercise's joint_actions list.",
    "units": "degrees",
    "sign_convention": {
      "shoulder.flexion": "0 = arm at side; positive = arm forward/up in the sagittal plane (relative to the TORSO, so it composes correctly after torso.flexion); negative = extension (arm behind body).",
      "shoulder.abduction": "0 = arm at side; positive = arm out to the side in the frontal plane. Capped at 120 because the rig has no scapulothoracic joint (true 180 deg elevation needs scapular upward rotation).",
      "shoulder.horizontal_adduction": "measured at 90 deg abduction; 0 = arm straight out to the side; positive = arm sweeps toward the midline/front; negative = arm sweeps behind the body.",
      "elbow.flexion": "0 = straight arm; positive = bent. No hyperextension.",
      "hip.flexion": "0 = anatomical standing; positive = thigh toward chest; negative = extension behind body.",
      "hip.abduction": "0 = legs together; positive = thigh away from midline.",
      "knee.flexion": "0 = straight leg; positive = heel toward buttock. No hyperextension.",
      "ankle.plantarflexion": "0 = neutral; positive = toes pointed down; negative = dorsiflexion (toes toward shin). Matches joint_axes.json rom_deg [-20, 50].",
      "torso.flexion": "0 = upright; positive = trunk pitched forward. SEE torso_caveat."
    },
    "rom_used": {
      "shoulder.flexion": [
        -40,
        120
      ],
      "shoulder.abduction": [
        0,
        120
      ],
      "shoulder.horizontal_adduction": [
        -30,
        75
      ],
      "elbow.flexion": [
        0,
        145
      ],
      "hip.flexion": [
        -15,
        110
      ],
      "knee.flexion": [
        0,
        140
      ],
      "ankle.plantarflexion": [
        -20,
        50
      ],
      "torso.flexion": [
        0,
        70
      ]
    },
    "no_double_mirroring": "Values are PER-SIDE ABSOLUTE anatomical magnitudes and are already correct for each side as written. The renderer maps DOF -> rig axis and may need a per-side axis sign flip, but must NOT additionally negate the .r values the way the old setBoth() helper did. single_arm_dumbbell_row is deliberately asymmetric and will be destroyed by blind mirroring.",
    "composition_order": "If composing multiple shoulder DOFs into one rotation, apply abduction (frontal) -> flexion (sagittal) -> horizontal_adduction (transverse). At most 2 shoulder DOFs are non-zero in any single pose here, to limit gimbal ambiguity.",
    "torso_caveat": "rig_config.json gives segment 'torso' pivot: null, so torso rotation is currently a no-op in the renderer (setPosePhase skips segments without a pivot). torso.flexion is also a LUMPED PROXY: for bent-over lifts (rows, deadlift) the real motion is a hip hinge, but the rig is rooted at the pelvis, so hip flexion would swing the LEGS up instead of pitching the trunk down. Values up to 70 therefore exceed true spinal flexion ROM on purpose. To use them, add a pivot to segment 'torso' near the L5-S1 junction -- derive it from the AABB of the 'Sacrum' / 'Vertebra L5' meshes rather than hardcoding a guess.",
    "renderer_note": "setPosePhase() currently interpolates identity -> target. This file needs start -> end interpolation (lerp per DOF). Wiring it as identity -> end would make barbell_squat and barbell_deadlift show nothing, because by the phase convention their END pose is near-neutral standing."
  },
